generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum SmsChannel {
  sms
  whatsapp
}

enum AuthProvider {
  phone
  apple
}

model SmsRequestCode {
  id String @id @default(cuid())

  phone String
  value String

  createdAt DateTime
  expiresAt DateTime
  channel   SmsChannel?
}

model CallWaitCode {
  id String @id @default(cuid())

  userPhone String
  phone     String

  isConfirmed Boolean @default(false)

  createdAt DateTime
  expiresAt DateTime
}

model User {
  id String @id

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  hashedRefreshToken String?

  // Optional contact info — not used for authentication
  phone String? @unique
  email String?
  name  String?

  // Stable Saleor handle, independent of identity providers.
  // Format: u{userId}@inji.kz. Created once at User creation, never changes.
  saleorEmail       String @unique
  // Random 32-byte secret used as the Saleor account password. AES-GCM
  // encrypted with secrets.encryptionKey. Treated as an opaque shared secret
  // between this backend and Saleor; clients never see it.
  saleorPasswordEnc String

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)
  isBanned  Boolean @default(false)

  sessions      Session[]
  identities    AuthIdentity[]
  appleSessions AppleSession[]

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  isRevoked Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// One row per (provider, external subject). Phone-login users get one
// row with provider=phone, subject=<normalized phone>. Apple-login users get
// provider=apple, subject=<apple.sub>. A user can have many identities.
model AuthIdentity {
  id       String       @id @default(cuid())
  provider AuthProvider
  subject  String
  email    String?
  rawData  Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

// Server-issued nonces for Apple Sign-In replay protection.
// Apple includes SHA256(nonce) as a claim in the identityToken; we match
// against this table and one-shot delete on consume.
model AppleAuthNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Apple refresh tokens (one per device sign-in), AES-GCM encrypted.
// Needed at account-deletion time to revoke Apple's grant via /auth/revoke.
model AppleSession {
  id              String   @id @default(cuid())
  appleSub        String
  refreshTokenEnc String
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([appleSub])
}

model Invoice {
  id           String   @id
  createdAt    DateTime @default(now())
  amount       Float
  // Owning user (identity). Phone may change/become null; userId is stable.
  userId       String?
  // Denormalized contact phone snapshot at order time. Display/contact only.
  userPhone    String?
  checkoutId   String?
  status       Int?
  operationUrl String?
  referenceId  String?
  key          String?
  userComment  String?
  products     Json?
  data         Json?

  @@index([userId])
}

model UserDevice {
  id        String   @id @default(cuid())
  pushToken String
  userId    String
  deviceId  String
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id        String  @id
  name      String
  category  String?
  barcode   String?
  isActive  Boolean @default(true)
  erpId     String?
  saleorId  String?
  price     Float?
  costPrice Float?

  isProcessedDietaGram Boolean @default(false)
  dietaGram            Json?

  isProcessedGoogle Boolean @default(false)
  google            Json?
}

model TelegramAuthRequest {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  hash      String
  phone     String?
  data      Json?
  // (c) Hash hardening: short-lived and single-use.
  expiresAt DateTime?
  usedAt    DateTime?
}

model DeliveryEstimate {
  id            String   @id
  createdAt     DateTime @default(now())
  route         Json?
  selectedClass String?
  phone         String?
  serviceLevels Json?
  data          Json?
}

model KaspiPaymentRequest {
  id           String    @id
  createdAt    DateTime  @default(now())
  userId       String?
  phone        String?
  checkoutData Json?
  amount       Float?
  // Outbox fields for the phone-automation worker (kaspi-automation --watch),
  // which auto-sends the Kaspi invoice. Kaspi has no API and no paid-callback,
  // so this tracks the SEND only, not payment.
  orderNumber  String?
  status       String    @default("pending") // pending | sending | sent | failed | skipped
  sentAt       DateTime?
  error        String?

  @@index([status])
}

model SavedCard {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String
  cardToken    String
  cardLastFour String

  @@index([userId])
}

// Idempotency guard for TipTopPay payment webhooks. The gateway retries the
// /hooks/payments/pay callback (network hiccups, timeouts), and without this a
// retry would create a second Saleor order / duplicate saved card. We insert a
// row keyed on the gateway idempotencyKey BEFORE doing any work; a duplicate
// callback hits the unique constraint and is skipped. status flips to
// 'processed' on success; a failed attempt deletes the row so a genuine retry
// can re-run.
model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  provider       String // e.g. "tiptoppay"
  // Gateway idempotency key — TipTopPay TransactionId (falls back to InvoiceId).
  idempotencyKey String   @unique
  status         String   @default("processing") // processing | processed

  @@index([idempotencyKey])
}

# =============================================================================
# inji-backend — environment variables (example)
#
# Usage:  cp .env.example .env   then fill in real values.
# The real .env is git-ignored; this file is committed and MUST NOT contain
# secrets — use placeholders only.
#
# Sources cross-checked: src/app/config/configuration.ts (process.env
# destructuring), the Joi validation schema in src/core/common/common.module.ts,
# direct process.env reads across src/, and prisma/schema.prisma (DATABASE_URL).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the app crash-loops or cannot function without these
# -----------------------------------------------------------------------------

# 32-byte key (exactly 64 hex chars) for AES-256-GCM secret encryption.
# Read as secrets.encryptionKey and ASSERTED at boot in
# src/core/auth/auth.service.ts onModuleInit (also used by apple-auth.service.ts,
# saleor-auth.service.ts, identity.service.ts). If missing, the whole app
# crash-loops at startup with:
#   "Required parameter secrets.encryptionKey was null or undefined when calling."
# Generate one with:  openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# Postgres connection string used by Prisma (prisma/schema.prisma -> env("DATABASE_URL")).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Secret used to sign/verify JWTs (src/core/auth/*: auth.module.ts,
# auth.service.ts, identity.service.ts). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# Runtime / app metadata
# -----------------------------------------------------------------------------

# One of: test | local | dev | prod  (validated by Joi).
# Affects logging format, Swagger (/api enabled only when ENV=dev), and whether
# the Telegram polling auth bot starts. Leave unset to behave as a prod-like env.
ENV=dev

# HTTP port the server listens on (app.listen(port)). No default — set it.
PORT=3002

APP_NAME="API"
APP_DESCRIPTION="inji API"
APP_VERSION=0.0.1

# CORS / origin host and the express-session secret (session middleware is
# currently commented out in main.ts, but SESSION_SECRET is still read).
ORIGIN_HOST=
SESSION_SECRET=replace-with-a-random-string

# -----------------------------------------------------------------------------
# Saleor / GraphQL backend
# (src/app/saleor/saleor.service.ts, src/app/catalog/catalog.service.ts,
#  src/core/auth/saleor-auth.service.ts)
# -----------------------------------------------------------------------------
GRAPHQL_CLIENT_URL=https://your-saleor-host/graphql/
SALEOR_BACKEND_URL=https://your-saleor-host/graphql/
SALEOR_BACKEND_TOKEN=your-saleor-app-token

# -----------------------------------------------------------------------------
# Kaspi invoice worker (kaspi-automation --watch) — src/core/auth/WorkerGuard.ts
# Shared bearer token the phone-automation worker presents to GET /kaspi/pending
# and POST /kaspi/:id/result. The worker sends it as "Authorization: Bearer
# <token>" (its KASPI_API_TOKEN). If unset, those two endpoints reject all calls.
# Generate one with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
KASPI_WORKER_TOKEN=

# -----------------------------------------------------------------------------
# SMSC (smsc.kz SMS provider) — src/app/messaging/sms/*
# -----------------------------------------------------------------------------
SMSC_USERNAME=
SMSC_PASSWORD=
SMSC_BASE_URL=https://smsc.kz

# -----------------------------------------------------------------------------
# Telegram (notifications + Telegram/WhatsApp auth) — src/app/messaging/telegram/*
# -----------------------------------------------------------------------------
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_AUTH_BOT_TOKEN=
# Bot username WITHOUT the leading "@" (e.g. your_auth_bot); returned to
# clients so deep-links are not hardcoded.
TELEGRAM_AUTH_BOT_USERNAME=
# WhatsApp number, digits only (e.g. 77000000000).
TELEGRAM_AUTH_WHATSAPP_PHONE=
# Secret guarding the Green API WhatsApp webhook (/v1/auth/whatsapp/hook). Set
# the SAME value as the Green API instance "webhookUrlToken"; Green API then
# sends it as "Authorization: Bearer <token>" and the server rejects calls that
# don't match. Leave empty to accept all (fail-open) — set it in any real env.
TELEGRAM_AUTH_WHATSAPP_WEBHOOK_TOKEN=
# Green API instance credentials (from the Green API console) used to send the
# WhatsApp confirmation reply after a login code is matched. SAME instance whose
# webhook posts to /v1/auth/whatsapp/hook. Leave empty to skip outbound replies.
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN_INSTANCE=
# Optional Green API host override (defaults to https://api.green-api.com).
GREEN_API_BASE_URL=
# One-time auth hash lifetime in minutes (default 10 if unset).
TELEGRAM_AUTH_HASH_TTL_MINUTES=10
# Force-enable the long-polling auth bot regardless of ENV ("true"/"false").
# Skipped by default on ENV=dev so dev laptops don't poll; a shared dev/staging
# box can opt in with TELEGRAM_AUTH_BOT_ENABLED=true.
TELEGRAM_AUTH_BOT_ENABLED=false
# Webhook mode (required for serverless / Vercel where long-polling does not
# survive). Public base URL, no trailing slash; webhook registers at
# <domain>/v1/telegram/webhook. Leave empty to use long-polling.
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_SECRET=
# Optional explicit override ("true"/"false"); defaults to true when a webhook
# domain is set.
# TELEGRAM_USE_WEBHOOK=

# -----------------------------------------------------------------------------
# Apple Sign-In — src/core/auth/apple-auth.service.ts
# All four of BUNDLE_ID/TEAM_ID/KEY_ID/PRIVATE_KEY must be set to enable signing
# client_secret for /auth/token and /auth/revoke. If any is missing, sign-in
# still works (identityToken is verified) but token-exchange/revoke are skipped.
# -----------------------------------------------------------------------------
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM-encoded ES256 private key from the Apple Developer portal.
# For a single-line value, escape newlines as \n.
APPLE_PRIVATE_KEY=
# Nonce lifetime in seconds (default 600 if unset).
APPLE_NONCE_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (push) — src/app/messaging/push/push.service.ts
# Provide credentials via ONE of:
#   1) the individual FIREBASE_* fields below, or
#   2) FIREBASE_SERVICE_ACCOUNT_JSON (full service-account JSON as a string), or
#   3) FIREBASE_SERVICE_ACCOUNT_PATH / GOOGLE_APPLICATION_CREDENTIALS (file path).
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key with newlines escaped as \n (the code un-escapes them).
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
# Alternatives to the fields above:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Yandex delivery / geo — src/app/delivery/*, src/app/geo/geo.service.ts
# -----------------------------------------------------------------------------
YANDEX_TAXI_TOKEN=

# -----------------------------------------------------------------------------
# TipTopPay (card payments) — src/app/hooks/order-hooks.service.ts and
# src/app/hooks/guards/tiptoppay-signature.guard.ts
# TIPTOP_PUBLIC_ID is the terminal Public ID ("pk_..."; also used on the client).
# TIPTOP_API_SECRET is the terminal API Secret — used to confirm payments AND as
# the HMAC key to verify incoming payment-webhook signatures. Required for the
# /hooks/payments/* endpoints to accept callbacks (they fail closed without it).
# Keep it secret; never commit a real value.
# -----------------------------------------------------------------------------
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=

# -----------------------------------------------------------------------------
# TLS — main.ts sets process.env.NODE_TLS_REJECT_UNAUTHORIZED = 0 at startup
# (disables TLS cert verification for outgoing requests). It is set in code, so
# you do NOT need to define it here; documented for awareness only.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# -----------------------------------------------------------------------------
# Legacy / optional — declared in configuration.ts or the Joi schema but NOT
# consumed by the current code (the app uses DATABASE_URL/Prisma for the DB).
# Safe to omit. Listed so this file matches configuration.ts exactly.
# -----------------------------------------------------------------------------
# Superseded by DATABASE_URL (config.db.* is never read):
# PG_HOST=
# PG_PORT=
# PG_USERNAME=
# PG_PWD=
# PG_DB=
# KeyDB/Redis config (config.keydb.* is never read):
# KEY_DB_HOST=
# KEY_DB_PORT=
# Validated by Joi only — used by CI/deploy tooling, not the app:
# IMAGE_REPO_NAME=
# AWS_REGION=
# AWS_ACCOUNT=

# NOTE: older .env files may also contain WOOPKASSA_*, GOOGLE_SERVICE_ACCOUNT_EMAIL,
# and SMS_CODE_SALT. These are NOT read anywhere in src/ and can be dropped.
